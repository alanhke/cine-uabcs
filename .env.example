# Copia este archivo como .env y llena los valores. Nunca subas el .env al repositorio.

# MySQL / TiDB Cloud. TiDB exige TLS: conserva ?sslaccept=strict al final.
DATABASE_URL="mysql://USUARIO:CONTRASEÑA@HOST:4000/cine_uabcs?sslaccept=strict"

NEXTAUTH_URL="http://localhost:3000"
# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET=""

TMDB_API_KEY=""
BLOB_READ_WRITE_TOKEN=""

# Nota: la zona horaria (La Paz, BCS = America/Mazatlan, UTC-7 fijo) se maneja
# en el código (src/lib/datetime.ts), no por la variable TZ. En Vercel TZ es
# una variable reservada y el runtime siempre es UTC.
