{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "rules": {
    "no-console": "error",
    "max-lines": ["error", { "max": 400, "skipBlankLines": false, "skipComments": false }]
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "src/test/**"],
      "rules": { "max-lines": "off" }
    }
  ]
}
